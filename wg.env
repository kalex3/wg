# Compose passes this file into the wg container.
# Values below are the entrypoint defaults.

# Host file ./${WG_INTERFACE}.conf is mounted at /etc/${WG_INTERFACE}.conf.
WG_INTERFACE=wg0

# Seconds between endpoint re-resolution for stale hostname peers. 0 disables it.
WG_RERESOLVE_INTERVAL=30

# true rejects traffic that would bypass a full tunnel (0.0.0.0/0 or ::/0).
# A split tunnel ignores this. Replies to inbound connections are still allowed.
WG_KILLSWITCH=false
